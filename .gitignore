# 跨平台
.DS_Store
Thumbs.db

# Python（代码开工后用）
__pycache__/
*.py[cod]
.venv/
venv/

# 本地数据（永不入库）
data/
packs/*_build/
assets/audio/
*.wav
*.opus
*.mp3
!docs/**/*.wav

# 日志与临时
*.log
/tmp/
.idea/
.vscode/

# 工具链会话/计划产物（不进仓：ZCode 会话计划、OpenCode 计划目录）
.zcode/*
# 例外：项目工作流是可复用资产（corpus-intake-analysis 等）——
# 注意 gitignore 不支持行尾注释，注释必须独立成行（本次踩过）
!.zcode/workflows/
.hermes/

# 云端评测凭据（本地专有，永不入库）
labs/cloud-bench/.env.local
*.env.local
